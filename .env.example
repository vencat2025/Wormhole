# Copy to .env and fill in. Never commit .env.
# Providers are optional: configure only the ones you intend to route to.
# Models whose provider has no key are excluded from routing automatically.

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Ollama needs no key. Install from https://ollama.com and pull a model:
#   ollama pull qwen2.5-coder:7b

# --- Gateway settings ---
# Model used for turns that carry tools (agentic CLI sessions). Must be one
# that reliably emits native function calls.
AGENTIC_MODEL=groq/openai/gpt-oss-120b
FALLBACK_MODEL=groq/openai/gpt-oss-120b

# Bearer auth for the gateway itself. Off by default for local use.
# When set to true you MUST supply at least one key, comma-separated.
ENABLE_AUTH=false
WORMHOLE_API_KEYS=

# SQLite by default; any SQLAlchemy URL works.
DATABASE_URL=sqlite:///./wormhole.db

# --- Routing policy ---
# Restrict routing to one vendor while still choosing the cheapest capable
# tier within it. Empty = the whole fleet.
#   ROUTING_PROVIDERS=openai
ROUTING_PROVIDERS=

# Which router decides the model:
#   slm  - local classifier, sub-millisecond, but bag-of-words over synthetic
#          templates; it does not generalise to unseen phrasing
#   llm  - one cheap model call (~200-400ms), semantic, far more robust
#   auto - slm when present, else llm
ROUTER_MODE=auto

# NOTE: verify these model ids still exist with your provider. Groq has
# decommissioned llama-3.3-70b-versatile and llama-3.1-8b-instant; pinning a
# retired model here makes the router, enhancer and judge fail silently into
# heuristics rather than erroring.
ROUTER_MODEL=groq/openai/gpt-oss-120b
ENHANCER_MODEL=groq/openai/gpt-oss-20b
# Scores every completion and steers router retraining. Must be able to tell
# good work from bad: see "Choosing the judge" in the README for measurements.
# Fully local option: ollama/gemma3:12b (slower, but nothing leaves the laptop).
# Do NOT use ollama/qwen2.5-coder:7b here; it rates a tutorial 8/10.
JUDGE_MODEL=groq/openai/gpt-oss-20b

# Lowest capability tier the router may pick: basic | medium | high | frontier.
# Empty means no floor.
#
# Set this before pointing a coding agent at the gateway. Advertising tool
# support is not the same as being able to drive an agentic harness: routed to
# gpt-5-nano, a one-line file-creation task in Claude Code spent 19 requests and
# never created the file. "medium" excludes that tier while keeping the cheap
# models that do work.
MIN_ROUTING_TIER=medium

# Narrower than ROUTING_PROVIDERS: the exact ladder of approved tiers.
# Keep tiers non-overlapping, or the choice between near-identical models is
# arbitrary. Example, an OpenAI-only policy ladder:
#   ROUTING_MODELS=gpt-5-nano,gpt-5-mini,gpt-5.4,gpt-5.6-sol
ROUTING_MODELS=

# Point the router at a local model to keep every prompt on this machine.
# Slower per decision (~2.5s vs ~300ms) but nothing leaves the laptop.
#   ROUTER_MODEL=ollama/qwen2.5-coder:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434
