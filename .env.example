# Copy to .env and fill in. Never commit .env.
# Providers are optional: configure only the ones you intend to route to.
# Models whose provider has no key are excluded from routing automatically.

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Ollama needs no key. Install from https://ollama.com and pull a model:
#   ollama pull qwen2.5-coder:7b

# --- Gateway settings ---
# Model used for turns that carry tools (agentic CLI sessions). Must be one
# that reliably emits native function calls.
AGENTIC_MODEL=groq/openai/gpt-oss-120b
FALLBACK_MODEL=groq/openai/gpt-oss-120b

# Bearer auth for the gateway itself. Off by default for local use.
# When set to true you MUST supply at least one key, comma-separated.
ENABLE_AUTH=false
WORMHOLE_API_KEYS=

# SQLite by default; any SQLAlchemy URL works.
DATABASE_URL=sqlite:///./wormhole.db
